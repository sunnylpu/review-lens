# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/reviewlens

# AI Provider Configuration
# Choose between: 'kimi', 'openrouter', 'groq', 'gemini'
AI_PROVIDER=kimi

# Moonshot AI (Kimi) Credentials
# Get your API key from: https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=moonshot-v1-8k

# OpenRouter Credentials (Free Tier Models Available)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Groq Credentials (Ultra-Fast Free Tier)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Credentials (Optional Alternative)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Batching & Rate Limiting Settings
BATCH_SIZE=5
MAX_RETRIES=3
BASE_DELAY_MS=1000
